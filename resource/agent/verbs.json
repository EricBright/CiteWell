    {
      "verb": "ping",
      "mcp": "citewell_status",
      "description": "Check that CiteWell is running and report its version.",
      "summary": "Version, data dir, capabilities",
      "api": "—",
      "mutating": false,
      "params": {},
      "required": []
    },
    {
      "verb": "search",
      "mcp": "search_library",
      "description": "Search the CiteWell library by title, creator, tag or full text.",
      "summary": "Full-text / field search, paged",
      "api": "Zotero.Search",
      "mutating": false,
      "params": {
        "query": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["query"]
    },
    {
      "verb": "item.get",
      "mcp": "get_item",
