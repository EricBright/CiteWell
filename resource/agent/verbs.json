      "summary": "New item from itemType + fields + creators, optionally into collections",
      "api": "new Zotero.Item, save",
      "mutating": true,
      "params": {
        "itemType": { "type": "string" },
        "fields": { "type": "object" },
        "creators": { "type": "array" },
        "tags": { "type": "array" },
        "collections": { "type": "array" }
      },
      "required": ["itemType"]
