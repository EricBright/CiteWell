      "summary": "Fields, creators, tags, notes, attachments",
      "api": "Zotero.Items.get",
      "mutating": false,
      "params": {
        "key": { "type": "string" }
      },
      "required": ["key"]
    },
    {
      "verb": "item.create",
      "mcp": "create_item",
