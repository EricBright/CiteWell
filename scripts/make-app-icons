#!/usr/bin/env python3

"""Regenerate the CiteWell application icons from one SVG.

    app/linux/icons/citewell.svg   master artwork (edit this)

Writes the launcher/taskbar PNGs, the AppImage desktop icon, and the copy the
About dialog uses. The toolbar quill is a different, monochrome mark and is
generated by scripts/make-z-icons.

Requires python3-gobject with Rsvg and cairo (librsvg2). This is the same
rasteriser docs/branding.md recommends; ImageMagick's SVG delegate is unusable.
"""

import sys
from pathlib import Path

try:
    import cairo
    import gi

    gi.require_version("Rsvg", "2.0")
    from gi.repository import Rsvg
except (ImportError, ValueError) as error:
    sys.exit(f"python3-gobject with Rsvg and cairo is required: {error}")

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "app/linux/icons/citewell.svg"

# (pixel size, destination). 32/64/128 are the window and launcher icons;
# 256 is what AppImage integration extracts for the desktop entry.
PNGS = [
    (32, ROOT / "app/linux/icons/icon32.png"),
    (64, ROOT / "app/linux/icons/icon64.png"),
    (128, ROOT / "app/linux/icons/icon128.png"),
    (256, ROOT / "packaging/citewell.png"),
]

# The About dialog renders the same mark at 200 px, so it uses the SVG itself.
ABOUT = ROOT / "chrome/skin/default/zotero/zotero.svg"


def render(handle, size, destination):
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    context = cairo.Context(surface)
    _, _, _, _, has_viewbox, viewbox = handle.get_intrinsic_dimensions()
    if not has_viewbox:
        sys.exit(f"{SOURCE} has no viewBox; cannot scale it to {size} px")
    scale = size / max(viewbox.width, viewbox.height)
    context.scale(scale, scale)
    viewport = Rsvg.Rectangle()
    viewport.x, viewport.y = viewbox.x, viewbox.y
    viewport.width, viewport.height = viewbox.width, viewbox.height
    handle.render_document(context, viewport)
    surface.write_to_png(str(destination))


def main():
    if not SOURCE.is_file():
        sys.exit(f"missing master artwork: {SOURCE}")

    handle = Rsvg.Handle.new_from_file(str(SOURCE))
    for size, destination in PNGS:
        render(handle, size, destination)
        print(f"{destination.relative_to(ROOT)}  {size}x{size}")

    ABOUT.write_text(SOURCE.read_text(encoding="utf-8"), encoding="utf-8")
    print(f"{ABOUT.relative_to(ROOT)}  copy of the master")


if __name__ == "__main__":
    main()
